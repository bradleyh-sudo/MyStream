rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Your own list: only you.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Shared lists: only members can see or change them.
    match /lists/{listId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        // Joining with an invite link: you may only add yourself.
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members));
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
    }
    // Popular on MyStream: each person's anonymous summary (titles only). Any signed-in user can read; only you can write yours.
    match /stats/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
